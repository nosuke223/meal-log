# macOS の Finder が自動生成するファイル
.DS_Store

# 依存、ビルド結果、テストの出力
node_modules/
dist/
playwright-report/
test-results/

# migrations/*.sql から作る、アプリに含めるマイグレーションの一覧（scripts/bundle-migrations.mjs）
server/migrations.generated.ts

# wrangler の手元の D1 などの保存先
.wrangler/

# 本番の D1 にマイグレーションを適用するための、所有者の手元の設定（docs/deploy.md）
wrangler.migrate.jsonc

# エージェントの PR 本文やコメントの下書き
.agent-tmp/
