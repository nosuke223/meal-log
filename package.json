{
  "name": "meal-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bundle-migrations": "node scripts/bundle-migrations.mjs",
    "predev": "npm run bundle-migrations",
    "dev": "npm run db:migrate:local && vite",
    "prelint": "npm run bundle-migrations",
    "lint": "eslint .",
    "pretest": "npm run bundle-migrations",
    "test": "vitest run",
    "prebuild": "npm run bundle-migrations",
    "build": "tsc -b && vite build",
    "pree2e": "npm run bundle-migrations",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc",
    "predev:api": "npm run bundle-migrations",
    "dev:api": "vite build && npm run db:migrate:local && wrangler pages dev dist --d1 DB=meal-log-local --compatibility-date 2026-11-01 --compatibility-flags nodejs_compat --binding DEV_USER_EMAIL=dev@example.com --binding BETTER_AUTH_SECRET=meal-log-local-development-only-secret-do-not-use-in-production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "better-auth": "^1.7.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
